<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 다크 그라디언트 배경 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#0A1628"
                android:endColor="#0E1320"
                android:type="linear" />
        </shape>
    </item>
    <!-- 좌측 상단 네온 엣지 글로우 -->
    <item
        android:right="-40dp"
        android:bottom="-40dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:startColor="#402563EB"
                android:endColor="#002563EB"
                android:centerX="0.0"
                android:centerY="0.0" />
        </shape>
    </item>
    <!-- 상단 네온 선 -->
    <item
        android:bottom="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1A2563EB" />
        </shape>
    </item>
</layer-list>
